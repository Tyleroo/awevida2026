---
// Home. Its wording and portrait are in src/data/pages/home.json; the slides come from the homes themselves.
import Base from '../layouts/Base.astro';
import HeroSlider from '../components/HeroSlider.astro';
import BioSplit from '../components/BioSplit.astro';
import page from '../data/pages/home.json';
import { sliderHomes, homeUrl } from '../data/homes';

// One slide per home that is switched on for the slider, in slide order.
const slides = sliderHomes.map((home) => ({
  title: home.title,
  label: home.slider.label || undefined,
  href: homeUrl(home.slug),
  id: home.slider.image,
}));
const bio = page.bio ?? {};
const paragraphs = (bio.paragraphs ?? []).filter((text) => text && text.trim());
---

<Base current="/" footerSocialLinks>
  <div class="home">
    {slides.length > 0 && (
      <HeroSlider title={page.slider?.title ?? ''} linkLabel={page.slider?.linkLabel || 'View the Home'} body={page.standfirst || undefined} label="Finished homes" slides={slides} interval={6000} />
    )}
    <BioSplit
      portrait={bio.portrait?.image}
      portraitAlt={bio.portrait?.alt}
      eyebrow={bio.eyebrow || undefined}
      name={bio.name ?? ''}
      paragraphs={paragraphs}
      cta={bio.buttonLabel ? { label: bio.buttonLabel, href: '/about/' } : undefined}
    />
  </div>
</Base>

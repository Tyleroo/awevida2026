---
// About Gabi. Wording and photos are in src/data/pages/about.json.
import Base from '../layouts/Base.astro';
import GalleryHero from '../components/GalleryHero.astro';
import Photo from '../components/Photo.astro';
import page from '../data/pages/about.json';
import { hasPhoto } from '../lib/photos';

// The rotating band. `position` nudges which slice of a photo shows (for example "50% 70%" favours the lower part).
const slides = (page.band ?? [])
  .filter((p) => hasPhoto(p?.image))
  .map((p) => ({ id: p.image, alt: p.alt, position: p.position || undefined }));
const family = page.family ?? {};
const paragraphs = (family.paragraphs ?? []).filter((text) => text && text.trim());
---

<Base title={page.title} current="/about/" shareImage={slides[1]?.id ?? slides[0]?.id}>
  <section class="about-intro">
    <div class="about-intro__inner">
      <h1>{page.title}</h1>
      <p>{page.intro}</p>
    </div>
  </section>

  {slides.length > 0 && <GalleryHero slides={slides} interval={6500} label="Photographs of finished homes" />}

  <section class="about-brings">
    <div class="about-brings__inner">
      <h2>{page.brings?.heading}</h2>
      <p>{page.brings?.text}</p>
    </div>
  </section>

  <section class="about-family">
    <div class="collage">
      <div class="collage__board">
        <div class="collage__piece collage__beach">
          <Photo id={family.wide1?.image} alt={family.wide1?.alt} sizes="(max-width: 1300px) 100vw, 1200px" class="av-fill" />
        </div>

        <div class="collage__bio">
          <p class="collage__eyebrow">{family.eyebrow}</p>
          {paragraphs.map((text) => <p>{text}</p>)}
        </div>

        <div class="collage__piece collage__piece--framed collage__couple">
          <Photo id={family.tall?.image} alt={family.tall?.alt} sizes="(max-width: 1099px) 520px, 520px" max={1200} class="av-fill" />
        </div>

        <div class="collage__piece collage__teens">
          <Photo id={family.wide2?.image} alt={family.wide2?.alt} sizes="(max-width: 1300px) 100vw, 1200px" class="av-fill" />
        </div>

        <div class="collage__piece collage__piece--framed collage__boys">
          <Photo id={family.small2?.image} alt={family.small2?.alt} sizes="(max-width: 1099px) 50vw, 174px" max={800} class="av-fill" />
        </div>

        <div class="collage__piece collage__piece--framed collage__girls">
          <Photo id={family.small1?.image} alt={family.small1?.alt} sizes="(max-width: 1099px) 50vw, 190px" max={800} class="av-fill" />
        </div>
      </div>
    </div>
  </section>
</Base>

---
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import Button from '../../components/Button.astro';
import { projects, type Project, type ProjectPhoto } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: Project }
const { project } = Astro.props;

// Tell the browser roughly how wide each photo is shown, so it downloads the right size.
const sizes = (item: ProjectPhoto) => {
  const pct = ((item.w / 1200) * 100).toFixed(1);
  return `(max-width: 720px) 100vw, (max-width: 1300px) ${pct}vw, ${Math.round(item.w)}px`;
};
const ratio = (item: ProjectPhoto) => (item.w / item.h).toFixed(4);
const description = project.intro || `${project.title}, ${project.location} — one of the homes renovated by Gabi Dalnekoff.`;
---

<Base title={`${project.title} — ${project.location}`} description={description} current="/portfolio/" shareImage={project.hero.id}>
  <div class="project-hero">
    <Photo id={project.hero.id} alt={project.hero.alt} sizes="100vw" class="av-fill" eager />
  </div>

  <section class="project-head">
    <div class="project-head__inner">
      <h1>{project.title}</h1>
      <p class="project-head__location">{project.location}</p>
      {project.intro && <p class="project-head__intro">{project.intro}</p>}
    </div>
  </section>

  <section class="project-gallery" style={`--row-gap: ${project.rowGap}px`}>
    <div class="wrap project-gallery__rows">
      {project.rows.map((row) => (
        <div class={`project-row project-row--${row.kind}`}>
          {row.items.map((item) => (
            <figure class="project-row__item" style={`--ratio: ${ratio(item)}`}>
              <Photo id={item.id} alt={item.alt} sizes={sizes(item)} max={item.w > 800 ? 2000 : 1200} class="av-fill" />
            </figure>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="band band--next">
    <h2 class="band__title">See the next home</h2>
    <Button href="/portfolio/" variant="light">Back to the Homes</Button>
  </section>
</Base>

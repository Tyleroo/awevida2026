---
// Portfolio. Wording and the top band's photos are in src/data/pages/portfolio.json; the cards are the homes.
import Base from '../../layouts/Base.astro';
import GalleryHero from '../../components/GalleryHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import Button from '../../components/Button.astro';
import page from '../../data/pages/portfolio.json';
import { homes, homeUrl } from '../../data/homes';
import { hasPhoto } from '../../lib/photos';

const slides = (page.band?.photos ?? []).filter((p) => hasPhoto(p?.image)).map((p) => ({ id: p.image, alt: p.alt }));
---

<Base title="Portfolio" description={page.description} current="/portfolio/" shareImage={slides[0]?.id}>
  {slides.length > 0 && <GalleryHero eyebrow={page.band?.eyebrow || undefined} slides={slides} interval={6500} label="Photographs of finished homes" />}

  <section class="band band--pale">
    <h1 class="band__title">{page.heading}</h1>
  </section>

  <section class="portfolio-grid">
    <div class="wrap">
      <div class="av-grid">
        {homes.map((home) => (
          <ProjectCard href={homeUrl(home.slug)} title={home.title} location={home.location} image={home.portfolio.image} />
        ))}
      </div>
    </div>
  </section>

  <section class="band band--sage">
    <h2 class="band__title">{page.closing?.heading}</h2>
    {page.closing?.buttonLabel && <Button href="/about/" variant="light">{page.closing.buttonLabel}</Button>}
  </section>
</Base>

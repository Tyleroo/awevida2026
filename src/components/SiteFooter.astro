---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Button from './Button.astro';
import { nav, site } from '../data/site';

interface Props { showSocialLinks?: boolean }
const { showSocialLinks = false } = Astro.props;
const social = (site.socialLinks ?? []).filter((s) => s?.href && s?.label);
const legal = `© ${new Date().getFullYear()} AweVida.${site.legalNote ? ' ' + site.legalNote : ''}`;
---

<footer class="av-footer">
  <Image src={logo} alt="AweVida" width={576} class="av-footer__logo" />
  {site.follow?.href && site.follow?.label && <Button href={site.follow.href} variant="light" external>{site.follow.label}</Button>}
  {showSocialLinks && social.length > 0 && (
    <ul class="av-footer__social">
      {social.map((s) => (
        <li><a class="av-footer__socially" href={s.href} target="_blank" rel="noopener">{s.label}</a></li>
      ))}
    </ul>
  )}
  <ul class="av-footer__nav">
    {nav.map((link) => <li><a class="av-footer__link" href={link.href}>{link.label}</a></li>)}
  </ul>
  <p class="av-footer__legal">{legal}</p>
</footer>

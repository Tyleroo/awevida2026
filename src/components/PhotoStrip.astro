---
// The band of rooms that scrolls left to right, on a loop, above the footer of every page.
import Photo from './Photo.astro';
import { site } from '../data/site';
import { hasPhoto } from '../lib/photos';

const photos = (site.strip?.photos ?? []).filter((p) => hasPhoto(p?.image));
// The list is doubled so the animation can slide exactly one copy's width and land back at its start.
const loop = [...photos, ...photos];
---

{photos.length > 0 && (
  <div class="av-strip" role="group" aria-label={site.strip?.label || 'Photographs of finished rooms'}>
    <div class="av-strip__track">
      {loop.map((p, i) => (
        <div class="av-strip__cell" aria-hidden={i >= photos.length ? 'true' : undefined}>
          <Photo id={p.image} alt={i >= photos.length ? '' : p.alt} sizes="330px" max={800} class="av-fill" />
        </div>
      ))}
    </div>
  </div>
)}

---
// One photograph, resized to several widths and served as WebP.
import { Image } from 'astro:assets';
import { hasPhoto, photo, widthsUpTo } from '../lib/photos';

interface Props {
  /** The photo: its path as saved by the editor ("/src/assets/photos/kitchen.jpg") or its file name. */
  id: string | null | undefined;
  alt: string;
  /** How wide the photo is shown, as an HTML `sizes` value, so browsers pick the right file. */
  sizes: string;
  /** Largest width worth generating for this spot. */
  max?: number;
  class?: string;
  /** Load straight away (for the first thing on the page) instead of lazily. */
  eager?: boolean;
  /** CSS object-position, for cropped photos that should favour one part of the picture. */
  position?: string;
}

const { id, alt, sizes, max = 2000, class: className, eager = false, position } = Astro.props;
// A photo that was removed or never uploaded is left out rather than breaking the whole site.
const found = hasPhoto(id);
if (!found) console.warn(`[photos] "${id}" is not in src/assets/photos/ - left out of ${Astro.url.pathname}`);
---

{found && (
  <Image
    src={photo(id)}
    alt={alt ?? ''}
    widths={widthsUpTo(max)}
    width={480}
    sizes={sizes}
    class={className}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    quality={78}
    style={position ? `object-position: ${position};` : undefined}
  />
)}
